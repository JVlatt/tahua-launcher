{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tahua Launcher",
  "mainBinaryName": "tahua-launcher",
  "version": "0.1.1",
  "identifier": "com.jvlatt.tahua.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Tahua Launcher",
        "width": 760,
        "height": 640,
        "minWidth": 520,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Install and update Tahua FFGL plugins for Resolume",
    "copyright": "Copyright (c) 2026 JVlatt",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEQjREQ0VCNjVEREJFQzkKUldUSnZ0MWw2OXkwSFQzeWkvWnozaWpHNGlIditDQ2VIT2M2N0JoNFJMdzRFeGFZTWhzbGFFeHMK",
      "endpoints": [
        "https://github.com/JVlatt/tahua-launcher/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
